# Original 9b7 packaging; upstream geomet is Apache-2.0.
pkgname=python-geomet
pkgver=1.1.0
pkgrel=1
pkgdesc='GeoJSON geometry helpers for the Cassandra driver'
arch=('any')
url='https://github.com/geomet/geomet'
license=('Apache-2.0')
depends=('python' 'python-click')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=('https://files.pythonhosted.org/packages/2a/8c/dde022aa6747b114f6b14a7392871275dea8867e2bd26cddb80cc6d66620/geomet-1.1.0.tar.gz')
sha256sums=('51e92231a0ef6aaa63ac20c443377ba78a303fd2ecd179dc3567de79f3c11605')
build() { cd "geomet-$pkgver"; python -m build --wheel --no-isolation; }
package() { cd "geomet-$pkgver"; python -m installer --destdir="$pkgdir" dist/*.whl; }
