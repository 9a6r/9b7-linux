# Original 9b7 packaging; pinned PyPI source hash, never a SKIP checksum.
pkgname=python-cassandra-driver
pkgver=3.30.1
pkgrel=1
pkgdesc='Apache Cassandra Python driver for the 9b7 database console'
arch=('x86_64')
url='https://github.com/apache/cassandra-python-driver'
license=('Apache-2.0')
depends=('python' 'python-geomet')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'cython' 'libev')
source=('https://files.pythonhosted.org/packages/bb/ed/4e16210e194660f107929ee494f1cf18557252655067d9b39029c241be2d/cassandra_driver-3.30.1.tar.gz')
sha256sums=('0c6a3e1428f7c6a9aa6c944b9c47a37cd2cdbeb5b5a82d42c33afdd56f14e398')
build() { cd "cassandra_driver-$pkgver"; python -m build --wheel --no-isolation; }
package() { cd "cassandra_driver-$pkgver"; python -m installer --destdir="$pkgdir" dist/*.whl; }
