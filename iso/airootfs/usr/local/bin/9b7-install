#!/usr/bin/env bash
# Whole-disk installer. No disk writes occur before the explicit ERASE confirmation.
set -euo pipefail
if [[ ${1:-} == --help ]]; then
    echo '9b7-install [--disk /dev/DEVICE] [--dry-run]'
    echo 'Run from the 9b7 Live ISO. This installer replaces the ENTIRE selected disk.'
    exit 0
fi
disk=''
dry_run=false
while (( $# )); do
    case "$1" in
        --disk) disk=${2:?missing disk}; shift 2 ;;
        --dry-run) dry_run=true; shift ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done
[[ $EUID == 0 ]] || { echo 'Run with sudo from the 9b7 live desktop.' >&2; exit 1; }
source_root=/run/archiso/airootfs
[[ -d $source_root && -d /run/archiso/bootmnt ]] || { echo 'This installer only runs inside the 9b7 Live ISO.' >&2; exit 1; }
lsblk -dpno NAME,SIZE,MODEL,TRAN
if [[ -z $disk ]]; then
    read -r -p 'Target WHOLE disk (example /dev/sda), or Ctrl+C to cancel: ' disk
fi
disk=$(readlink -f "$disk")
[[ -b $disk && $(lsblk -dnro TYPE "$disk") == disk ]] || { echo 'Choose a whole block disk, not a partition.' >&2; exit 1; }
[[ $(lsblk -dnro RO "$disk") == 0 ]] || { echo 'Target is read-only.' >&2; exit 1; }
# Refuse a disk containing any current mount, including the boot medium and root.
if lsblk -nro MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then
    echo 'Target has mounted filesystems; refusing to touch it. Unmount only the intended target partitions first.' >&2
    exit 1
fi
live_source=$(findmnt -nro SOURCE /run/archiso/bootmnt)
if [[ -b $live_source ]] && lsblk -snrpo NAME "$live_source" | grep -Fxq "$disk"; then
    echo 'Target contains the live boot medium; refusing.' >&2; exit 1
fi
required_bytes=$(( $(du -sx --apparent-size --block-size=1 "$source_root" | cut -f1) + 20*1024*1024*1024 ))
disk_bytes=$(blockdev --getsize64 "$disk")
(( disk_bytes >= required_bytes )) || { echo 'Target needs the installed image size plus at least 20 GiB for working data.' >&2; exit 1; }
cat <<PLAN
Target: $disk
Plan: erase partition table; create 2 MiB BIOS boot partition, 1 GiB EFI partition,
then ext4 root; copy this exact live system; install BIOS + UEFI GRUB;
create user 9b7 / password 9b7 and an 8 GiB swap file.
All existing data on $disk will be destroyed. This is not a dual-boot installer.
PLAN
if $dry_run; then exit 0; fi
[[ -t 0 ]] || { echo 'Interactive confirmation is required on a terminal.' >&2; exit 1; }
read -r -p "Type ERASE $disk to continue: " confirmation
[[ $confirmation == "ERASE $disk" ]] || { echo 'Cancelled.'; exit 1; }
target=$(mktemp -d /mnt/9b7-install.XXXXXX)
cleanup() {
    if mountpoint -q "$target"; then umount -R "$target" || true; fi
    rmdir "$target" 2>/dev/null || true
}
trap cleanup EXIT
wipefs --all "$disk"
parted --script "$disk" mklabel gpt \
    mkpart BIOS 1MiB 3MiB set 1 bios_grub on \
    mkpart EFI fat32 3MiB 1027MiB set 2 esp on \
    mkpart ROOT ext4 1027MiB 100%
partprobe "$disk"
udevadm settle
partition_prefix=$disk
[[ $disk != *[0-9] ]] || partition_prefix="${disk}p"
efi="${partition_prefix}2"
root="${partition_prefix}3"
mkfs.fat -F32 -n 9B7_EFI "$efi"
mkfs.ext4 -F -L 9B7_ROOT "$root"
mount "$root" "$target"
mkdir -p "$target/boot/efi"
mount "$efi" "$target/boot/efi"
rsync -aHAX --numeric-ids --info=progress2 "$source_root/" "$target/"
# archiso keeps its boot kernel on the ISO filesystem, outside the compressed root.
install -m 644 /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux "$target/boot/vmlinuz-linux"
mkdir -p "$target/etc/mkinitcpio.conf.d" "$target/etc/default"
rm -f "$target/etc/mkinitcpio.conf.d/archiso.conf" "$target/etc/initcpio/hooks/archiso" \
    "$target/etc/systemd/system/multi-user.target.wants/pacman-init.service" \
    "$target/etc/systemd/system/multi-user.target.wants/choose-mirror.service" \
    "$target/etc/systemd/system/multi-user.target.wants/reflector.service"
cat > "$target/etc/mkinitcpio.conf.d/9b7.conf" <<'INITRAMFS'
HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
INITRAMFS
cat > "$target/etc/default/grub" <<'GRUB'
GRUB_DEFAULT=0
GRUB_TIMEOUT=8
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="9b7"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_OS_PROBER=true
GRUB
# Generate a normal host initramfs, not the live ISO one.
cat > "$target/etc/mkinitcpio.d/linux.preset" <<'PRESET'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
PRESET
genfstab -U "$target" > "$target/etc/fstab"
arch-chroot "$target" /usr/local/bin/9b7-firstboot
arch-chroot "$target" locale-gen
arch-chroot "$target" pacman-key --init
arch-chroot "$target" pacman-key --populate archlinux
arch-chroot "$target" systemd-machine-id-setup
arch-chroot "$target" mkinitcpio -P
arch-chroot "$target" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=9b7 --removable --no-nvram
arch-chroot "$target" grub-install --target=i386-pc "$disk"
arch-chroot "$target" grub-mkconfig -o /boot/grub/grub.cfg
arch-chroot "$target" fallocate -l 8G /swapfile
chmod 600 "$target/swapfile"
arch-chroot "$target" mkswap /swapfile
printf '/swapfile none swap defaults 0 0\n' >> "$target/etc/fstab"
rm -f "$target/usr/share/applications/9b7-install.desktop"
sync
echo 'Installation finished. Shut down, remove the ISO/USB, then boot the installed disk.'
echo 'Login: 9b7 / 9b7. Change the password after your graduation demonstration.'
